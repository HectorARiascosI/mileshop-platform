FROM node:24-bookworm-slim AS build

WORKDIR /app

COPY package.json package-lock.json ./
COPY tsconfig.base.json ./
COPY apps ./apps
COPY packages ./packages
COPY services ./services

RUN npm ci

ARG SERVICE_DIR
ARG SERVICE_WORKSPACE

RUN if [ -f "/app/${SERVICE_DIR}/prisma/schema.prisma" ]; then \
      npm run db:generate --workspace="${SERVICE_WORKSPACE}"; \
    fi
RUN npm run build --workspace="${SERVICE_WORKSPACE}"
RUN npm prune --omit=dev

FROM node:24-bookworm-slim AS runtime

ENV NODE_ENV=production
WORKDIR /app

ARG SERVICE_DIR
ARG SERVICE_WORKSPACE

COPY --from=build --chown=node:node /app/package.json /app/package-lock.json ./
COPY --from=build --chown=node:node /app/node_modules ./node_modules
COPY --from=build --chown=node:node /app/${SERVICE_DIR} ./${SERVICE_DIR}

USER node

EXPOSE 3000

HEALTHCHECK --interval=30s --timeout=3s --start-period=15s --retries=3 \
  CMD node -e "fetch('http://127.0.0.1:' + (process.env.PORT || 3000) + '/healthz').then(r => process.exit(r.ok ? 0 : 1)).catch(() => process.exit(1))"

CMD ["sh", "-c", "node ${SERVICE_DIR}/dist/main.js"]
