# Copy this file to an untracked .env file before running Docker Compose.
# Use TLS PostgreSQL URLs from the database provider and do not commit real credentials.
WEB_ORIGIN=https://your-store.example
API_BIND_ADDRESS=127.0.0.1
API_PORT=3000
DATABASE_URL_NOTIFICATIONS=postgresql://USER:PASSWORD@DB_HOST:5432/notifications?sslmode=require
DATABASE_URL_CATALOG=postgresql://USER:PASSWORD@DB_HOST:5432/catalog?sslmode=require
DATABASE_URL_ORDERS=postgresql://USER:PASSWORD@DB_HOST:5432/orders?sslmode=require
DATABASE_URL_IDENTITY=postgresql://USER:PASSWORD@DB_HOST:5432/identity?sslmode=require
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
CATALOG_RESERVATION_TOKEN=replace-with-a-random-internal-token-at-least-32-characters
NOTIFICATION_SENDER_MODE=log
