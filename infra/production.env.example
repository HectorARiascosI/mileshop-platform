# Copy to infra/.env.production on the server. Keep real credentials out of Git.
# Use TLS PostgreSQL URLs. Each service needs its own database.
API_DOMAIN=api.your-store.example
WEB_ORIGIN=https://your-store.example
DATABASE_URL_NOTIFICATIONS=postgresql://notifications:REPLACE_ME@DB_HOST:5432/notifications?sslmode=require
DATABASE_URL_CATALOG=postgresql://catalog:REPLACE_ME@DB_HOST:5432/catalog?sslmode=require
DATABASE_URL_ORDERS=postgresql://orders:REPLACE_ME@DB_HOST:5432/orders?sslmode=require
DATABASE_URL_IDENTITY=postgresql://identity:REPLACE_ME@DB_HOST:5432/identity?sslmode=require
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
ORDERS_INTERNAL_TOKEN=replace-with-a-random-internal-token-at-least-32-characters
CATALOG_RESERVATION_TOKEN=replace-with-a-random-reservation-token-at-least-32-characters
CATALOG_INVENTORY_COMMAND_TOKEN=replace-with-a-random-inventory-token-at-least-32-characters
PAYMENT_EVIDENCE_HOST_DIR=/var/lib/mileshop/payment-evidence
NOTIFICATION_SENDER_MODE=log
