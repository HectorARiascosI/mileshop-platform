{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "outputDirectory": "dist",
  "buildCommand": "npm run db:generate && npm run build",
  "functions": {
    "api/handler.ts": {
      "includeFiles": "../../packages/contracts/src/**",
      "maxDuration": 30
    }
  },
  "rewrites": [
    {
      "source": "/api/:mileshopPath*",
      "destination": "/api/handler"
    }
  ]
}
