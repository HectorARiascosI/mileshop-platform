generator client {
  provider = "prisma-client-js"
  output   = "../generated/catalog-client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Product {
  id          String   @id @default(cuid())
  sku         String   @unique
  name        String
  description String
  priceCop    Int
  stock       Int
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([isActive, name])
}

model InventoryReservation {
  id           String                     @id @default(cuid())
  orderId      String                     @unique
  requestLines Json
  status       String                     @default("RESERVED")
  createdAt    DateTime                   @default(now())
  items        InventoryReservationLine[]
  movements    InventoryMovement[]

  @@index([status, createdAt])
}

model InventoryReservationLine {
  id             String               @id @default(cuid())
  reservationId  String
  productId      String
  sku            String
  name           String
  quantity       Int
  unitPriceCop   Int
  reservation    InventoryReservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)

  @@unique([reservationId, productId])
}

model InventoryMovement {
  id             String               @id @default(cuid())
  reservationId  String
  productId      String
  movementType   String
  quantityDelta  Int
  createdAt      DateTime             @default(now())
  reservation    InventoryReservation @relation(fields: [reservationId], references: [id], onDelete: Restrict)

  @@unique([reservationId, productId, movementType])
  @@index([productId, createdAt])
}
