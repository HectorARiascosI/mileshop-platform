DATABASE_URL=postgresql://orders:orders@localhost:5435/orders?schema=public
PORT=3030
ALLOWED_ORIGINS=http://localhost:3000
RATE_LIMIT_MAX=120
ORDERS_INTERNAL_TOKEN=
# Private filesystem storage. In production, point this at a persistent volume.
PAYMENT_EVIDENCE_STORAGE=local
# Resolved from the orders-service working directory; .data/ is gitignored.
PAYMENT_EVIDENCE_LOCAL_DIR=../../.data/payment-evidence
# Production example (set only when this absolute path is backed by persistent storage):
# PAYMENT_EVIDENCE_LOCAL_DIR=/var/lib/mileshop/payment-evidence
# Set to true only after legal/accounting approval of the retention policy.
PAYMENT_EVIDENCE_RETENTION_ENABLED=false
