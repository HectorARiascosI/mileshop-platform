generator client {
  provider = "prisma-client-js"
  output   = "../generated/orders-client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Order {
  id              String      @id @default(cuid())
  orderId         String      @unique
  idempotencyKey  String      @unique
  customerId      String
  subtotalCop     Int
  deliveryFeeCop  Int
  totalCop        Int
  status          String      @default("PENDING")
  requestFingerprint String
  reservationExpiresAt DateTime?
  cancelRequestedAt DateTime?
  cancelResolvedAt DateTime?
  cancelResolution String?
  cancelResolvedByCustomerId String?
  cancelResolutionNote String?
  cancelPaymentCaptured Boolean?
  externalRefundRecordedByCustomerId String?
  externalRefundReference String?
  externalRefundHandledAt DateTime?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  lines           OrderLine[]
  paymentEvidence PaymentEvidence?
  paymentDecision PaymentDecision?
  inventoryCommands InventoryCommandOutbox[]

  @@index([customerId, createdAt])
}

enum PaymentDecisionType {
  APPROVED
  REJECTED
}

enum InventoryCommandType {
  RESERVE
  COMMIT
  RELEASE
}

enum InventoryCommandStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

model PaymentEvidence {
  id String @id @default(cuid())
  orderId String @unique
  storageKey String?
  originalFileName String?
  contentType String?
  sizeBytes Int
  transactionReference String?
  receivedAt DateTime @default(now())
  retentionUntil DateTime?
  legalHold Boolean @default(false)
  cleanupClaimToken String?
  cleanupLeaseExpiresAt DateTime?
  deletedAt DateTime?
  deletedByCustomerId String?
  deletionReason String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  order Order @relation(fields: [orderId], references: [orderId], onDelete: Cascade)
  legalHolds PaymentEvidenceLegalHold[]

  @@unique([storageKey])
  @@index([retentionUntil, legalHold, deletedAt])
  @@index([cleanupLeaseExpiresAt])
}

model PaymentEvidenceLegalHold {
  id String @id @default(cuid())
  paymentEvidenceId String
  setByCustomerId String
  reason String
  setAt DateTime @default(now())
  releasedByCustomerId String?
  releaseReason String?
  releasedAt DateTime?
  paymentEvidence PaymentEvidence @relation(fields: [paymentEvidenceId], references: [id], onDelete: Cascade)

  @@index([paymentEvidenceId, setAt])
}

model PaymentDecision {
  id String @id @default(cuid())
  orderId String @unique
  decision PaymentDecisionType
  adminCustomerId String
  decidedAt DateTime @default(now())
  reason String?
  order Order @relation(fields: [orderId], references: [orderId], onDelete: Cascade)

  @@index([adminCustomerId, decidedAt])
}

model InventoryCommandOutbox {
  commandId String @id
  idempotencyKey String @unique
  orderId String
  commandType InventoryCommandType
  payload Json
  status InventoryCommandStatus @default(PENDING)
  attemptCount Int @default(0)
  nextAttemptAt DateTime @default(now())
  claimToken String?
  leaseExpiresAt DateTime?
  lastError String?
  completedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  order Order @relation(fields: [orderId], references: [orderId], onDelete: Cascade)

  @@index([status, nextAttemptAt])
  @@index([status, leaseExpiresAt])
  @@index([orderId, createdAt])
}

model OrderLine {
  id           String @id @default(cuid())
  productId    String
  sku          String
  name         String
  quantity     Int
  unitPriceCop Int
  order        Order  @relation(fields: [orderId], references: [id])
  orderId      String

  @@index([orderId, productId])
}

model OrderEventOutbox {
  id            String    @id @default(cuid())
  eventId       String    @unique
  eventType     String
  aggregateId   String
  occurredAt    DateTime
  payload       Json
  status        String    @default("PENDING")
  attemptCount  Int       @default(0)
  nextAttemptAt DateTime  @default(now())
  lastError     String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  publishedAt   DateTime?

  @@index([status, nextAttemptAt, createdAt])
}

model ReservationIntent {
  intentId      String   @id
  orderId       String   @unique
  customerId    String
  idempotencyKey String  @unique
  status        String   @default("PENDING")
  lines         Json
  payload       Json
  createdAt     DateTime @default(now())
  nextAttemptAt DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([status, nextAttemptAt, createdAt])
}
