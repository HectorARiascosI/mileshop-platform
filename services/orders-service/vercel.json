{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "outputDirectory": "dist",
  "buildCommand": "npm run db:generate && npm run build",
  "functions": {
    "api/handler.ts": {
      "maxDuration": 30
    }
  },
  "crons": [
    {
      "path": "/api/internal/maintenance",
      "schedule": "0 5 * * *"
    }
  ],
  "rewrites": [
    {
      "source": "/api/:mileshopPath*",
      "destination": "/api/handler"
    }
  ]
}
